# Copy to .env to override defaults. Relative paths resolve against the project root.
# RAG_PDF_DIR=data/raw/pdf
# RAG_MD_DIR=data/raw/md
# RAG_CHUNKS_DIR=data/processed/chunks
# RAG_HF_HOME=Z:/.cache/huggingface  # Hugging Face download cache; keep it off a full C: drive

# Stage 1: parse
# RAG_PARSE_LAYOUT=true          # pymupdf4llm ML layout mode; false = legacy mode with TOC-based headings
# RAG_PARSE_WORKERS=26           # default: cpu_count - 2
# RAG_PARSE_ORT_THREADS=1        # ONNX threads per worker; >1 oversubscribes the CPU

# Stage 2: chunk (token sizes are measured with RAG_EMBED_MODEL's tokenizer)
# RAG_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# RAG_CHUNK_MAX_TOKENS=512
# RAG_CHUNK_OVERLAP_TOKENS=64
# RAG_CHUNK_MIN_TOKENS=128
# RAG_CHUNK_DROP_TOKENS=24
# RAG_CHUNK_WORKERS=26

# Stage 3: embed + index
# RAG_EMBEDDINGS_DIR=data/processed/embeddings
# RAG_EMBED_BATCH_SIZE=32          # lower if the GPU runs out of memory
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_COLLECTION=arxiv_chunks
# RAG_INDEX_PAPERS_PER_BATCH=16
# RAG_UPSERT_BATCH=128
# RAG_PREFETCH_LIMIT=50

# Stage 4: ask
# RAG_REWRITE_MODEL=qwen3:8b       # query rewrite + metadata extraction; qwen3:4b is faster
# RAG_REWRITE_ALT_QUERIES=2
# RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# RAG_RERANK_CANDIDATES=50
# RAG_ANSWER_TOP_K=8
# RAG_CONTEXT_MAX_TOKENS=3500
# RAG_CONTEXT_MIN_SCORE=0.05
# RAG_OLLAMA_URL=http://localhost:11434
# RAG_OLLAMA_MODEL=qwen3:8b        # e.g. qwen3:4b if answers are too slow
# RAG_OLLAMA_NUM_CTX=8192
# RAG_OLLAMA_THINK=false
# RAG_OLLAMA_KEEP_ALIVE=0
